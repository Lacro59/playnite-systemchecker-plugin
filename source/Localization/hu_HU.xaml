<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<!-- General -->
	<sys:String x:Key="LOCSystemChecker">Rendszerellenőrző</sys:String>
	<sys:String x:Key="LOCSystemCheckerCheckConfig">Rendszer követelmények ellenőrzése</sys:String>
	<sys:String x:Key="LOCSystemCheckerRefreshPcInfo">Rendszer információ frissítése</sys:String>

	<!-- Settings — PC configuration -->
	<sys:String x:Key="LOCSystemCheckerPcConfigDescription">A SystemChecker összehasonlítja a játék rendszerkövetelményeit a számítógép hardverével. Az alábbi értékeket a rendszer automatikusan felismeri; a processzor és a videókártya nevét felülírhatod, ha az azonosítás hibás, vagy a benchmark programok nem ismeri fel őket.</sys:String>
	<sys:String x:Key="LOCSystemCheckerDetectedHardware">Észlelt hardver</sys:String>
	<sys:String x:Key="LOCSystemCheckerManualOverrides">Kézi felülírások</sys:String>
	<sys:String x:Key="LOCSystemCheckerManualOverrideHint">Ha egy mezőt üresen hagy, akkor a rendszer az észlelt értéket veszi alapul. Írjon be egy nevet, vagy nyissa meg a PassMark listát, hogy kiválasszon egy benchmark bejegyzést.</sys:String>
	<sys:String x:Key="LOCSystemCheckerPickBenchmark">PassMark lista…</sys:String>
	<sys:String x:Key="LOCSystemCheckerPickCpu">Válassz processzort (PassMark)</sys:String>
	<sys:String x:Key="LOCSystemCheckerPickGpu">Válassz videókártyát (PassMark)</sys:String>
	<sys:String x:Key="LOCSystemCheckerBenchmarkSearch">Benchmarkok keresése</sys:String>
	<sys:String x:Key="LOCSystemCheckerBenchmarkLoading">Benchmark lista betöltése…</sys:String>
	<sys:String x:Key="LOCSystemCheckerRetagOnManualConfigChange">A kompatibilitási címkék frissítése a CPU vagy GPU beállítások kézi módosítása esetén</sys:String>

	<!-- Game Details View -->
	<sys:String x:Key="LOCSystemCheckerConfigBelowMinimum">Minimum alatt</sys:String>
	<sys:String x:Key="LOCSystemCheckerConfigMinimum">Minimum</sys:String>
	<sys:String x:Key="LOCSystemCheckerConfigRecommended">Ajánlott</sys:String>
	<sys:String x:Key="LOCSystemCheckerOS">Operációs rendszer</sys:String>
	<sys:String x:Key="LOCSystemCheckerCpu">Processzor</sys:String>
	<sys:String x:Key="LOCSystemCheckerRam">Memória</sys:String>
	<sys:String x:Key="LOCSystemCheckerGpu">Grafika</sys:String>
	<sys:String x:Key="LOCSystemCheckerDisk">Tárhely</sys:String>

	<!-- Search -->
	<sys:String x:Key="LOCSystemCheckerSearchDescription">System Checker adatainak keresése</sys:String>
	<sys:String x:Key="LOCSystemCheckerSearchHint" xml:space="preserve">Paraméterel:
    -min		Megfelel a minimális követelményeknek
    -rec		Megfelel az ajánlott követelményeknek
    -any		Megfelel a minimális vagy az ajánlott követelményeknek
    -np		Soha nem játszott
    -fav		Csak a kedvencek
    -stores={n}	Szűrés bolt alapján (pl. -stores=steam / -stores=steam,epic)
    -status={n}	Szűrés játék állapot alapján (pl. -status=played / -status=played,playing)</sys:String>

	<!-- Search Results -->
	<sys:String x:Key="LOCSystemCheckerSearchMeetsMinimum">✅ Megfelel a minimális követelményeknek</sys:String>
	<sys:String x:Key="LOCSystemCheckerSearchMeetsRecommended">✅ Megfelel az ajánlott követelményeknek</sys:String>
	<sys:String x:Key="LOCSystemCheckerSearchBelowMinimum">⚠️ Minimum követelmény alatt</sys:String>
	<sys:String x:Key="LOCSystemCheckerSearchNoData">ℹ️ Nincs elérhető követelmény adat</sys:String>
	<sys:String x:Key="LOCSystemCheckerSearchSecondaryAction">Részletek mutatása</sys:String>

	<!-- Notifications -->
	<sys:String x:Key="LOCSystemCheckerTryRefresh">A(z) {0} bővítmény adatainak frissítése</sys:String>
	<sys:String x:Key="LOCSystemCheckerAddTagError">Hiba történt a címkék hozzáadása közben. Kérjük, próbálja meg újra.</sys:String>
	<sys:String x:Key="LOCSystemCheckerRemoveTagError">Hiba történt a címkék eltávolítása közben. Kérjük, próbálja meg újra.</sys:String>
	<sys:String x:Key="LOCSystemCheckerClearAllError">Hiba történt a bővítmény adatainak törlése közben. Kérjük, próbálja meg újra.</sys:String>

</ResourceDictionary>
